<Project>
  <!-- A test project for one operating system (TestOperatingSystem: Linux, Windows or OSX) builds on every
       host, so its code is always compiled, and is a test application only on its own: dotnet test runs
       the projects whose IsTestingPlatformApplication is true. -->
  <PropertyGroup Condition="'$(TestOperatingSystem)' != '' and !$([MSBuild]::IsOSPlatform('$(TestOperatingSystem)'))">
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsTestProject>false</IsTestProject>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <OutputType>Library</OutputType>
    <!-- Built only so the solution builds here; its module initializer belongs to the test host it is on its OS. -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>
</Project>
