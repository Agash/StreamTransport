#version 450
// 4:2:0 Y'CbCr planes to RGB. With unpack 1 the input is a side-by-side frame twice the output width:
// colour from the left half, and alpha from the right half's luma, normalised like the colour's. With
// unpack 2 it is a stacked frame twice the output height, the alpha in the bottom half.

// Chroma is left-sited (H.264, H.265 and AV1's default): a sample sits on every other column, between two
// rows. So an even column takes it as it is and an odd one the mean of its two neighbours, and each row
// weighs the chroma row it falls in 3:1 against the next nearest.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r8) uniform readonly image2D luma;
layout(set = 0, binding = 1, rg8) uniform readonly image2D chroma;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform Parameters
{
    uint outWidth;
    uint outHeight;
    uint unpack;       // 1: alpha comes from the right half's luma; 2: from the bottom half's
    uint swapRedBlue;  // 1: the output's memory is BGRA, written through an RGBA view
    vec4 lumaScale;    // x: offset subtracted from Y', y: scale after it, z: neutral chroma
    vec4 rowR;         // R = dot(vec3(Y, Cb, Cr), rowR.xyz) + rowR.w, on normalised Y, Cb, Cr
    vec4 rowG;
    vec4 rowB;
} p;

// The chroma for luma column x on chroma row r, interpolated across columns.
vec2 chromaRow(uint x, uint r, uint last)
{
    uint c = x / 2;
    vec2 here = imageLoad(chroma, ivec2(c, r)).rg;
    return (x & 1u) == 0u ? here : (here + imageLoad(chroma, ivec2(min(c + 1, last), r)).rg) * 0.5;
}

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= p.outWidth || id.y >= p.outHeight)
    {
        return;
    }

    float y = (imageLoad(luma, ivec2(id)).r - p.lumaScale.x) * p.lumaScale.y;
    uint lastColumn = (p.outWidth + 1) / 2 - 1;
    uint row = id.y / 2;
    uint other = (id.y & 1u) == 0u ? max(row, 1u) - 1 : min(row + 1, (p.outHeight + 1) / 2 - 1);
    vec2 cbcr = chromaRow(id.x, row, lastColumn) * 0.75 + chromaRow(id.x, other, lastColumn) * 0.25
        - p.lumaScale.z;
    vec3 ycc = vec3(y, cbcr);
    vec3 rgb = clamp(vec3(dot(ycc, p.rowR.xyz) + p.rowR.w,
                          dot(ycc, p.rowG.xyz) + p.rowG.w,
                          dot(ycc, p.rowB.xyz) + p.rowB.w), 0.0, 1.0);

    float alpha = 1.0;
    if (p.unpack != 0)
    {
        ivec2 at = p.unpack == 1u ? ivec2(id.x + p.outWidth, id.y) : ivec2(id.x, id.y + p.outHeight);
        float a = imageLoad(luma, at).r;
        alpha = clamp((a - p.lumaScale.x) * p.lumaScale.y, 0.0, 1.0);
    }

    // The output is written through an RGBA view; a BGRA image takes its channels swapped, which any
    // GPU can store where a BGRA storage view needs a feature not all have.
    vec4 rgba = vec4(rgb, alpha);
    imageStore(outputImage, ivec2(id), p.swapRedBlue != 0 ? rgba.bgra : rgba);
}
