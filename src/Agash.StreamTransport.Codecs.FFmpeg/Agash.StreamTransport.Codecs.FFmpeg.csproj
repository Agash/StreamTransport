<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Agash.StreamTransport.Codecs.FFmpeg</RootNamespace>
    <PackageId>Agash.StreamTransport.Codecs.FFmpeg</PackageId>
    <Description>H.264, H.265 and AV1 video encoders and decoders for Agash.StreamTransport on FFmpeg: Direct3D 12, NVENC, AMF, QSV, Vulkan, VA-API, VideoToolbox and software backends behind the Media codec contracts, fed from GPU surfaces without a copy where the backend allows. Bring FFmpeg 9 shared libraries.</Description>
    <PackageTags>video;codec;encoder;decoder;h264;h265;hevc;av1;ffmpeg;d3d12;nvenc;amf;qsv;vaapi;vulkan;videotoolbox;streaming;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agash.StreamTransport.Media\Agash.StreamTransport.Media.csproj" />
    <ProjectReference
      Include="$(FFmpegInteropProject)"
      Condition="'$(UseLocalFFmpegInterop)' == 'true'"
    />
    <PackageReference Include="FFmpeg.Interop" Condition="'$(UseLocalFFmpegInterop)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <InternalsVisibleTo Include="Agash.StreamTransport.Codecs.FFmpeg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The pinned FFmpeg shared libraries, fetched per RID into native/ffmpeg/<rid>/ by
    eng/fetch-ffmpeg.ps1 (gitignored), packed as runtimes/<rid>/native so a consumer restoring for a
    RID gets only that platform's libraries. FFmpeg is LGPL; its licence text goes with them.
  -->
  <ItemGroup>
    <_FFmpegNative Include="../../native/ffmpeg/**/*.dll;../../native/ffmpeg/**/*.so*;../../native/ffmpeg/**/*.dylib" />
    <None
      Include="@(_FFmpegNative)"
      Pack="true"
      PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)"
      Visible="false"
    />
    <None
      Include="../../native/ffmpeg/FFMPEG-LICENSE.txt"
      Condition="Exists('../../native/ffmpeg/FFMPEG-LICENSE.txt')"
      Pack="true"
      PackagePath=""
      Visible="false"
    />
  </ItemGroup>
</Project>
