<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection"
      Version="11.0.0-rc.3.26522.148"
    />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion
      Include="Microsoft.Extensions.Logging.Console"
      Version="11.0.0-rc.3.26522.148"
    />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- TensorPrimitives: vectorized span math (audio level, sample conversion, FEC parity). -->
    <PackageVersion Include="System.Numerics.Tensors" Version="11.0.0-rc.3.26522.148" />
    <!-- Hardware CRC-32 for STUN FINGERPRINT. -->
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Dtls.Core" Version="0.1.0-alpha.1" />
    <PackageVersion Include="FFmpeg.Interop" Version="0.1.0-alpha.1" />
    <PackageVersion Include="Opus.Interop" Version="0.1.0-alpha.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />

    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Managed Opus. -->
    <!-- Platform GPU capture and sharing, for the platform packages. -->
    <PackageVersion Include="Spout2.NET" Version="0.1.0-alpha.3" />
    <PackageVersion Include="Syphon.NET" Version="0.1.0-alpha.7" />
    <PackageVersion Include="PipeWire.NET.Media" Version="0.3.0-dev2" />
    <PackageVersion Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>
</Project>
